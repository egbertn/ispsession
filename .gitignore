# Ignore build artifacts
bin/
obj/
*.exe
*.dll
*.pdb
*.log
*.cache

# Ignore user-specific files
*.user
*.suo
*.vs

# Ignore IDE settings
.vscode/
.idea/
*.csproj.user
*.sln.cache
*.sln.docstates

# Ignore NuGet packages
packages/
*.nupkg
project.lock.json

# Ignore temporary files
*.tmp
*.swp

# Ignore configuration files with potential secrets
# Note: base appsettings.json is tracked; only environment-specific overrides are ignored.
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json
appsettings.Local.json
secrets.json

